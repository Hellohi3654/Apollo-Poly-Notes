{
   "manifest_version": 3,
   "name": "Apollo Pics + NEM Tracker",
   "version": "1.5.3",
   "description": "Apollo Missions + NEM Info",
   "icons": {
      "128": "icons/new-tab-icon.png"
   },
   "chrome_url_overrides": {
      "newtab": "index.html"
   },
   "permissions": [ 
      "storage",
      "declarativeNetRequest"
   ],
   "host_permissions": [
     "https://*.nemwatch.com.au/*",
     "https://*.aemo.com.au/*",
     "https://*.global-roam.com/*"
   ],
   "declarative_net_request": {
      "rule_resources": [{
         "id": "ruleset_1",
         "enabled": true,
         "path": "rules.json"
      }]
   },
   "content_scripts": [
     {
       "matches": [
         "https://ausrealtimefueltype.global-roam.com/*"
       ],
       "all_frames": true,
       "css": ["css/fuel_dark.css"],
       "run_at": "document_start"
     },
     {
       "matches": [
         "https://ausrealtimefueltype.global-roam.com/*"
       ],
       "all_frames": true,
       "js": ["js/fuel_dark.js"],
       "world": "MAIN",
       "run_at": "document_start"
     }
   ],
   "web_accessible_resources": [
     {
       "resources": ["css/fuel_dark.css", "js/fuel_dark.js"],
       "matches": ["https://ausrealtimefueltype.global-roam.com/*"]
     }
   ]
}
