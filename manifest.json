{
   "manifest_version": 3,
   "name": "Apollo Pics + NEM Tracker",
   "version": "1.5.1",
   "description": "Apollo Missions + NEM Info",
   "icons": {
      "128": "icons/new-tab-icon.png"
   },
   "chrome_url_overrides": {
      "newtab": "index.html"
   },
   "permissions": [ 
      "storage",
      "declarativeNetRequest"
   ],
   "host_permissions": [
     "https://*.gridiq.com.au/*",
     "https://*.nemwatch.com.au/*"
   ],
   "declarative_net_request": {
      "rule_resources": [{
         "id": "ruleset_1",
         "enabled": true,
         "path": "rules.json"
      }]
   }
}
